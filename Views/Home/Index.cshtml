@using System.Globalization
@model InventarioExpres.Models.InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="text-center my-4">
    <h1 class="fw-bold">Control de Inventario Exprés</h1>
</div>

<div class="row g-4">
    <!-- PRODUCTOS -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Últimos productos <span class="badge bg-secondary">@Model.TotalProductos</span></h4>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalProducto">+ Nuevo</button>
                </div>

                @if (Model.UltimosProductos.Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="text-muted small">
                            <tr><th>Nombre</th><th>Stock</th><th>Precio</th><th>Proveedor</th><th class="text-end">Acciones</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.UltimosProductos)
                            {
                                <tr>
                                    <td>@p.Nombre</td>
                                    <td>
                                        @if (p.Stock <= 5)
                                        {
                                            <span class="badge bg-danger">@p.Stock</span>
                                        }
                                        else
                                        {

                                            @p.Stock
                                        }
                                    </td>
                                    <td>@p.Precio.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@p.Proveedor?.Nombre</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Editar" aria-label="Editar"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarProducto"
                                                data-id="@p.Id" data-nombre="@p.Nombre" data-stock="@p.Stock"
                                                data-precio="@p.Precio.ToString("0.00", CultureInfo.InvariantCulture)"
                                                data-proveedor="@p.ProveedorId">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                data-id="@p.Id" data-nombre="@p.Nombre"
                                                data-url="@Url.Action("Delete", "Productos")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11v1z" /></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No hay productos registrados.</p>
                }
            </div>
        </div>
    </div>

    <!-- PROVEEDORES -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Proveedores <span class="badge bg-secondary">@Model.TotalProveedores</span></h4>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalProveedor">+ Nuevo</button>
                </div>

                @if (Model.UltimosProveedores.Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="text-muted small">
                            <tr><th>Nombre</th><th>Teléfono</th><th>Productos</th><th class="text-end">Acciones</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.UltimosProveedores)
                            {
                                <tr>
                                    <td>@v.Nombre</td>
                                    <td>@v.Telefono</td>
                                    <td>@v.Productos.Count</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Editar" aria-label="Editar"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarProveedor"
                                                data-id="@v.Id" data-nombre="@v.Nombre" data-telefono="@v.Telefono">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"
                                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                data-id="@v.Id" data-nombre="@v.Nombre"
                                                data-url="@Url.Action("Delete", "Proveedores")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11v1z" /></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No hay proveedores registrados.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- MODAL NUEVO PROVEEDOR -->
<div class="modal fade" id="modalProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form asp-controller="Proveedores" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="desdeInicio" value="true" />
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input name="Telefono" type="tel" class="form-control" required maxlength="20" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR PROVEEDOR -->
<div class="modal fade" id="modalEditarProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form asp-controller="Proveedores" asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Editar proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="desdeInicio" value="true" />
                    <input type="hidden" name="Id" />
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input name="Telefono" type="tel" class="form-control" required maxlength="20" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL NUEVO PRODUCTO -->
<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form asp-controller="Productos" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="desdeInicio" value="true" />

                    @if (!Model.TodosProveedores.Any())
                    {
                        <div class="alert alert-warning">Primero debes registrar un proveedor.</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Stock</label>
                            <input name="Stock" type="number" class="form-control" required min="0" max="100000" step="1" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Precio</label>
                            <input name="Precio" type="number" class="form-control" required min="0.01" max="1000000" step="0.01" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Proveedor</label>
                        <select name="ProveedorId" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var prov in Model.TodosProveedores)
                            {
                                <option value="@prov.Id">@prov.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" disabled="@(!Model.TodosProveedores.Any())">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR PRODUCTO -->
<div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form asp-controller="Productos" asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Editar producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="desdeInicio" value="true" />
                    <input type="hidden" name="Id" />
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Stock</label>
                            <input name="Stock" type="number" class="form-control" required min="0" max="100000" step="1" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Precio</label>
                            <input name="Precio" type="number" class="form-control" required min="0.01" max="1000000" step="0.01" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Proveedor</label>
                        <select name="ProveedorId" class="form-select" required>
                            @foreach (var prov in Model.TodosProveedores)
                            {
                                <option value="@prov.Id">@prov.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CONFIRMAR ELIMINAR (compartido) -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <form method="post" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="desdeInicio" value="true" />
                    <input type="hidden" name="id" />
                    <p class="mb-0">¿Seguro que deseas eliminar <strong id="nombreEliminar"></strong>? Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Rellena el modal de editar proveedor
        document.getElementById('modalEditarProveedor').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            this.querySelector('[name=Id]').value = b.dataset.id;
            this.querySelector('[name=Nombre]').value = b.dataset.nombre;
            this.querySelector('[name=Telefono]').value = b.dataset.telefono;
        });

        // Rellena el modal de editar producto
        document.getElementById('modalEditarProducto').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            this.querySelector('[name=Id]').value = b.dataset.id;
            this.querySelector('[name=Nombre]').value = b.dataset.nombre;
            this.querySelector('[name=Stock]').value = b.dataset.stock;
            this.querySelector('[name=Precio]').value = b.dataset.precio;
            this.querySelector('[name=ProveedorId]').value = b.dataset.proveedor;
        });

        // Prepara el modal de eliminar (sirve para productos y proveedores)
        document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            this.querySelector('form').action = b.dataset.url;
            this.querySelector('[name=id]').value = b.dataset.id;
            document.getElementById('nombreEliminar').textContent = b.dataset.nombre;
        });
    </script>
}